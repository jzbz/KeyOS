//
// Balance global — companion-reported figures.
//
// The device is airgapped and cannot fetch balances itself; an online
// companion (DCR Pulse) reports them via SD card or QR (see balance.rs).
// Until something loads, the card shows the "—" placeholder.
export global Balance {
    in property <string> dcr-amount: "—";
    in property <string> fiat-amount: "";
    // "Updated via SD card · 2h ago" — the transport that supplied these
    // figures, shown small under the balance. Empty = nothing loaded.
    in property <string> source-note: "";
    // Freshness, e.g. "as of 2h ago". Optional.
    in property <string> as-of: "";
}
