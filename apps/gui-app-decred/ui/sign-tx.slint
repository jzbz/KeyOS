//
// Signing flow state shared between Rust (sign_tx.rs) and the Slint pages.
// The page renders one of these states; Rust drives transitions.

// One recipient on the review screen, pre-split for the verification grid:
// two rows of 5-char groups with the outer groups emphasized.
export struct RecipientView {
    top-first: string,
    top-rest: string,
    bottom-rest: string,
    bottom-last: string,
    amount: string,
}

export struct SdFile {
    name: string,
    detail: string,
}

export enum SignState {
    // Nothing loaded — offer QR / SD entry points.
    Idle,
    // Browsing the card: user picks which .dcrtx to load.
    Picking,
    // Camera open, assembling an animated-QR (UR) sign request.
    Scanning,
    // Decoded; showing recipients / amount / fee for confirmation.
    Review,
    // Signed; presenting the signed tx as an animated QR to scan back.
    ShowQr,
    // Signed; written to SD card.
    Done,
    // Something refused or failed (see error-text).
    Error,
}

export enum OriginView {
    Qr,
    SdCard,
}

export global SignTx {
    in property <SignState> state: SignState.Idle;
    in property <OriginView> origin: OriginView.Qr;

    // Review summary, pre-formatted as "1.2345 DCR" strings in Rust because
    // Slint int is 32-bit and atom values overflow it.
    in property <string> send-total;
    in property <string> fee;
    in property <string> change;
    in property <int> recipient-count;
    // Destination address(es) — THE critical thing to verify on-device.
    in property <string> recipient;
    // Per-recipient verification cards (replaces the joined string above).
    in property <[RecipientView]> recipients;
    // Named account this request spends from (from the request, not the UI).
    in property <string> signing-account;
    // Estimated fee rate, e.g. "≈ 12 atoms/B (est.)".
    in property <string> fee-rate;
    // True when the fee is suspiciously large relative to the send.
    // (There is no mislabelled-change warning: since dcr-rs 0.3.0 a change
    // output must carry the path that proves it, so a lie is refused outright
    // rather than displayed for the user to override.)
    in property <bool> fee-warning: false;
    // Whether the user has acknowledged the high-fee warning.
    in-out property <bool> fee-acknowledged: false;

    // Result / failure surfaces.
    in property <string> saved-path;
    in property <string> error-text;

    // Animated-QR frames for the signed transaction (UR parts).
    pure callback signed-qr-parts() -> [string];

    // User actions.
    callback start-qr-scan();
    // Enter the file picker (lists .dcrtx files on the card).
    callback load-from-sd();
    // Files found on the card, newest first.
    in property <[SdFile]> sd-files;
    // Load the selected file by name.
    callback pick-file(string);
    // Hidden debug: rotate through all files (sim fuzz testing). The tap
    // target only exists when Rust enables it (hosted sim, never hardware).
    in property <bool> debug-enabled: false;
    callback debug-cycle();
    callback approve();
    callback reject();
}
